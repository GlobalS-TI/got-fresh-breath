DATABASE_URL=postgresql://gfb_user:gfb_password@localhost:5433/gfb_dev
PAYLOAD_SECRET=YOUR_SECRET_HERE
# URL pública del sitio — usada para restringir CORS/CSRF de Payload al origen propio
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Google Tag Manager — contenedor único que gestiona GA4, Google Ads y demás pixeles/tags.
# Los tags (GA4 Configuration, Ads Conversion, etc.) se configuran dentro de tagmanager.google.com;
# no hace falta tocar código para agregarlos o cambiarlos.
NEXT_PUBLIC_GTM_ID=

# Resend (notificaciones por correo de nuevos leads/pedidos)
RESEND_API_KEY=
# Opcional — por defecto usa onboarding@resend.dev hasta verificar un dominio propio en Resend
RESEND_FROM_EMAIL=
# Opcional — correo interno que recibe las notificaciones, por defecto contacto@gotfreshbreath.mx
NOTIFICATION_EMAIL=

# PayPal (checkout) — mientras no estén configuradas, /carrito solo muestra
# transferencia/cotización y el botón de PayPal se oculta
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Opcional — por defecto sandbox; usar https://api-m.paypal.com en producción
PAYPAL_API_BASE=

# Webhook saliente al CRM (nuevos leads) — inactivo mientras no estén configuradas
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
